<?xml version="1.0" encoding="UTF-8"?>
<runscript name="F450_nominal_mission_profile_workflow">
  <description>F450 nominal multirotor mission profile: motor start, takeoff, climb, loiter-style mission segment, descent, landing, and motor shutdown.</description>
  <use aircraft="F450" initialize="/home/junyeopkwon/jsbsim_workflow/scripts/F450/initial_condition/1.0__ground_park_init.xml"/>

  <run start="0.0" end="32.0" dt="0.002">
    <property value="0" persistent="true"> simulation/notify-time-trigger </property>
    <property value="0" persistent="true"> fcs/ScasEngage </property>

    <event name="Pre-start idle">
      <condition> simulation/frame le 1 </condition>
      <set name="fcs/throttle-cmd-norm" value="0.0"/>
      <set name="fcs/aileron-cmd-norm" value="0.0"/>
      <set name="fcs/elevator-cmd-norm" value="0.0"/>
      <set name="fcs/rudder-cmd-norm" value="0.0"/>
      <notify/>
    </event>

    <event name="Ground trim">
      <condition> simulation/frame gt 1 </condition>
      <set name="simulation/do_simple_trim" value="2"/>
      <notify/>
    </event>

    <event name="Motor start and spin-up">
      <condition> simulation/sim-time-sec ge 1.0 </condition>
      <set name="fcs/throttle-cmd-norm" value="0.20"/>
      <notify/>
    </event>

    <event name="Takeoff">
      <condition> simulation/sim-time-sec ge 3.0 </condition>
      <set name="fcs/ScasEngage" value="1.0"/>
      <set name="fcs/throttle-cmd-norm" value="0.50"/>
      <notify/>
    </event>

    <event name="Climb">
      <condition> simulation/sim-time-sec ge 5.0 </condition>
      <set name="fcs/throttle-cmd-norm" value="0.455"/>
      <notify/>
    </event>

    <event name="Mission loiter">
      <condition> simulation/sim-time-sec ge 12.0 </condition>
      <set name="fcs/throttle-cmd-norm" value="0.380"/>
      <set name="fcs/elevator-cmd-norm" value="0.0"/>
      <set name="fcs/aileron-cmd-norm" value="0.0"/>
      <set name="fcs/rudder-cmd-norm" value="0.0"/>
      <notify/>
    </event>

    <event name="Descent">
      <condition> simulation/sim-time-sec ge 22.0 </condition>
      <set name="fcs/throttle-cmd-norm" value="0.400"/>
      <notify/>
    </event>

    <event name="Landing settle">
      <condition> simulation/sim-time-sec ge 24.0 </condition>
      <set name="fcs/throttle-cmd-norm" value="0.220"/>
      <set name="fcs/elevator-cmd-norm" value="0.0"/>
      <set name="fcs/aileron-cmd-norm" value="0.0"/>
      <set name="fcs/rudder-cmd-norm" value="0.0"/>
      <notify/>
    </event>

    <event name="Touchdown and motor idle">
      <condition> simulation/sim-time-sec ge 28.0 </condition>
      <set name="fcs/throttle-cmd-norm" value="0.12"/>
      <notify/>
    </event>

    <event name="Motor shutdown">
      <condition> simulation/sim-time-sec ge 30.0 </condition>
      <set name="fcs/ScasEngage" value="0.0"/>
      <set name="fcs/throttle-cmd-norm" value="0.0"/>
      <set name="fcs/elevator-cmd-norm" value="0.0"/>
      <set name="fcs/aileron-cmd-norm" value="0.0"/>
      <set name="fcs/rudder-cmd-norm" value="0.0"/>
      <notify/>
    </event>

    <event name="Repeating notify" persistent="true">
      <condition> simulation/sim-time-sec ge simulation/notify-time-trigger </condition>
      <set name="simulation/notify-time-trigger" value="2.0" type="FG_DELTA"/>
      <notify>
        <property> fcs/ScasEngage </property>
        <property> fcs/throttle-cmd-norm </property>
        <property> fcs/elevator-cmd-norm </property>
        <property> fcs/rudder-cmd-norm </property>
        <property> position/h-agl-ft </property>
        <property> velocities/v-down-fps </property>
        <property> velocities/v-east-fps </property>
        <property> velocities/v-north-fps </property>
        <property> attitude/phi-deg </property>
        <property> attitude/theta-deg </property>
        <property> attitude/psi-deg </property>
        <property> propulsion/engine[0]/propeller-rpm </property>
        <property> propulsion/engine[1]/propeller-rpm </property>
        <property> propulsion/engine[2]/propeller-rpm </property>
        <property> propulsion/engine[3]/propeller-rpm </property>
      </notify>
    </event>
  </run>
</runscript>
