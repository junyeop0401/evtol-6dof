<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="http://jsbsim.sf.net/JSBSimScript.xsl"?>
<runscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://jsbsim.sf.net/JSBSimScript.xsd" name="standard_vtol_demo JSBSim arming check">
  <use aircraft="standard_vtol_demo" initialize="initGrnd"/>
  <run start="0.0" end="1.0" dt="0.01">
    <property value="0.0">simulation/notify-time-trigger</property>
    <event name="Commands before arming">
      <condition>simulation/sim-time-sec ge 0.05</condition>
      <set name="fcs/motor-armed" value="0.0"/>
      <set name="fcs/esc-cmd-norm[0]" value="0.25"/>
      <set name="fcs/esc-cmd-norm[1]" value="0.35"/>
      <set name="fcs/esc-cmd-norm[2]" value="0.45"/>
      <set name="fcs/esc-cmd-norm[3]" value="0.55"/>
      <set name="fcs/esc-cmd-norm[4]" value="0.65"/>
    </event>
    <event name="Arm all five motors">
      <condition>simulation/sim-time-sec ge 0.50</condition>
      <set name="fcs/motor-armed" value="1.0"/>
    </event>
    <event name="Repeating notify" persistent="true">
      <condition>simulation/sim-time-sec ge simulation/notify-time-trigger</condition>
      <notify>
        <property>simulation/sim-time-sec</property>
        <property>fcs/motor-armed</property>
        <property>fcs/esc-cmd-norm[0]</property>
        <property>fcs/esc-out[0]</property>
        <property>fcs/esc-cmd-norm[1]</property>
        <property>fcs/esc-out[1]</property>
        <property>fcs/esc-cmd-norm[2]</property>
        <property>fcs/esc-out[2]</property>
        <property>fcs/esc-cmd-norm[3]</property>
        <property>fcs/esc-out[3]</property>
        <property>fcs/esc-cmd-norm[4]</property>
        <property>fcs/esc-out[4]</property>
      </notify>
      <set name="simulation/notify-time-trigger" value="0.25" type="FG_DELTA"/>
    </event>
  </run>
  <output name="standard_vtol_demo_arming_check.csv" type="CSV" rate="100">
    <property>simulation/sim-time-sec</property>
    <property>fcs/motor-armed</property>
    <property>fcs/esc-cmd-norm[0]</property>
    <property>fcs/esc-out[0]</property>
    <property>fcs/esc-cmd-norm[1]</property>
    <property>fcs/esc-out[1]</property>
    <property>fcs/esc-cmd-norm[2]</property>
    <property>fcs/esc-out[2]</property>
    <property>fcs/esc-cmd-norm[3]</property>
    <property>fcs/esc-out[3]</property>
    <property>fcs/esc-cmd-norm[4]</property>
    <property>fcs/esc-out[4]</property>
  </output>
</runscript>
