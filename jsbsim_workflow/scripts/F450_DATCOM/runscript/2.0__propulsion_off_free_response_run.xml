<?xml version='1.0' encoding='UTF-8'?>
<runscript xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='http://jsbsim.sf.net/JSBSimScript.xsd' name='F450 DATCOM propulsion-off aero free response'>
  <description>
    Common propulsion-off free-response test for separating aerodynamic effects from multicopter motor and controller effects.
    Starts at 100 m AGL with 10 m/s initial speed and 5 deg pitch, keeps autopilot and throttle disabled, then logs aero force/moment for 8 seconds.
  </description>
  <use aircraft='F450_DATCOM' initialize='initGrnd' />
  <run start='0.0' end='8.0' dt='0.002'>
    <property value='0'>simulation/mission-state</property>
    <event name='Disable autopilot and motors'>
      <condition>simulation/frame le 1</condition>
      <set name='simulation/mission-state' value='1' />
      <set name='ap/mode' value='0' />
      <set name='fcs/ScasEngage' value='0.0' />
      <set name='fcs/throttle-cmd-norm' value='0.0' />
      <set name='fcs/aileron-cmd-norm' value='0.0' />
      <set name='fcs/elevator-cmd-norm' value='0.0' />
      <set name='fcs/rudder-cmd-norm' value='0.0' />
    </event>
    <event name='Terminate free response'>
      <condition>simulation/sim-time-sec ge 8.0</condition>
      <set name='simulation/terminate' value='1' />
    </event>
  </run>
  <output name='unused_template_output.csv' type='CSV' rate='120'>
    <property>simulation/sim-time-sec</property><property>position/h-agl-ft</property><property>velocities/vt-fps</property><property>velocities/u-fps</property><property>velocities/w-fps</property><property>velocities/h-dot-fps</property><property>attitude/phi-deg</property><property>attitude/theta-deg</property><property>attitude/psi-deg</property><property>fcs/throttle-cmd-norm</property><property>fcs/effective-aileron-pos-deg</property><property>fcs/elevator-pos-deg</property><property>aero/alpha-deg</property><property>aero/beta-deg</property><property>aero/qbar-area</property><property>aero/coefficient/CL_base</property><property>aero/coefficient/CD_base</property><property>aero/coefficient/Cm_base</property><property>forces/fbx-aero-lbs</property><property>forces/fby-aero-lbs</property><property>forces/fbz-aero-lbs</property><property>moments/l-aero-lbsft</property><property>moments/m-aero-lbsft</property><property>moments/n-aero-lbsft</property><property>forces/fbx-total-lbs</property><property>forces/fby-total-lbs</property><property>forces/fbz-total-lbs</property><property>moments/l-total-lbsft</property><property>moments/m-total-lbsft</property><property>moments/n-total-lbsft</property><property>propulsion/engine/thrust-lbs</property><property>propulsion/engine[1]/thrust-lbs</property><property>propulsion/engine[2]/thrust-lbs</property><property>propulsion/engine[3]/thrust-lbs</property>
  </output>
</runscript>
