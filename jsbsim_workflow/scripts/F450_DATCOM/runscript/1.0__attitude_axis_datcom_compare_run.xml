<?xml version='1.0' encoding='UTF-8'?>
<runscript xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='http://jsbsim.sf.net/JSBSimScript.xsd' name='F450 DATCOM attitude comparison diagnostic'>
  <description>
    Common multicopter attitude-mode diagnostic for comparing original F450 and F450_DATCOM.
    The vehicle climbs to 10 m AGL in altitude-hold mode, then receives roll and pitch
    setpoint steps while holding altitude. Aerodynamic and DATCOM aerosurface properties
    are listed in the template output so the combined CSV runner carries them into logs.
  </description>
  <use aircraft='F450_DATCOM' initialize='initGrnd' />
  <run start='0.0' end='80.0' dt='0.002'>
    <property value='0'>simulation/notify-time-trigger</property>
    <property value='0'>simulation/mission-state</property>
    <event name='Initialize attitude comparison diagnostic'>
      <condition>simulation/frame le 1</condition>
      <set name='simulation/mission-state' value='0' />
      <set name='ap/mode' value='0' />
      <set name='fcs/throttle-cmd-norm' value='0.0' />
      <set name='ap/altitude-reference' value='0' />
      <set name='ap/heading-setpoint-rad' value='0.0' />
      <set name='ap/roll-setpoint-rad' value='0.0' />
      <set name='ap/pitch-setpoint-rad' value='0.0' />
      <set name='ap/north-setpoint-m' value='0.0' />
      <set name='ap/east-setpoint-m' value='0.0' />
      <set name='ap/altitude-setpoint-ft' value='0.55' />
    </event>
    <event name='Trim ground state'><condition>simulation/frame gt 1</condition><set name='simulation/do_simple_trim' value='2' /></event>
    <event name='Climb to 10 m with level attitude'><condition>simulation/sim-time-sec ge 2.0</condition><set name='simulation/mission-state' value='1' /><set name='ap/mode' value='2' /><set name='ap/roll-setpoint-rad' value='0.0' /><set name='ap/pitch-setpoint-rad' value='0.0' /><set name='ap/altitude-setpoint-ft' value='32.80839895' /></event>
    <event name='Command positive roll'><condition>simulation/sim-time-sec ge 20.0</condition><set name='simulation/mission-state' value='2' /><set name='ap/roll-setpoint-rad' value='0.08' /><set name='ap/pitch-setpoint-rad' value='0.0' /></event>
    <event name='Command negative roll'><condition>simulation/sim-time-sec ge 30.0</condition><set name='simulation/mission-state' value='3' /><set name='ap/roll-setpoint-rad' value='-0.08' /><set name='ap/pitch-setpoint-rad' value='0.0' /></event>
    <event name='Command positive pitch'><condition>simulation/sim-time-sec ge 40.0</condition><set name='simulation/mission-state' value='4' /><set name='ap/roll-setpoint-rad' value='0.0' /><set name='ap/pitch-setpoint-rad' value='0.08' /></event>
    <event name='Command negative pitch'><condition>simulation/sim-time-sec ge 50.0</condition><set name='simulation/mission-state' value='5' /><set name='ap/roll-setpoint-rad' value='0.0' /><set name='ap/pitch-setpoint-rad' value='-0.08' /></event>
    <event name='Return level and hover for 10 seconds'><condition>simulation/sim-time-sec ge 60.0</condition><set name='simulation/mission-state' value='6' /><set name='ap/roll-setpoint-rad' value='0.0' /><set name='ap/pitch-setpoint-rad' value='0.0' /></event>
    <event name='Terminate after final hover window'><condition>simulation/sim-time-sec ge 70.0</condition><set name='simulation/mission-state' value='7' /><set name='simulation/terminate' value='1' /></event>
  </run>
  <output name='unused_template_output.csv' type='CSV' rate='120'>
    <property>simulation/sim-time-sec</property><property>simulation/mission-state</property><property>ap/mode</property><property>ap/roll-setpoint-rad</property><property>ap/pitch-setpoint-rad</property><property>position/h-agl-ft</property><property>velocities/v-north-fps</property><property>velocities/v-east-fps</property><property>velocities/h-dot-fps</property><property>attitude/phi-deg</property><property>attitude/theta-deg</property><property>attitude/psi-deg</property><property>ap/roll-cmd-norm</property><property>ap/pitch-cmd-norm</property><property>ap/yaw-cmd-norm</property><property>ap/collective-cmd-norm</property><property>fcs/aileron-cmd-norm</property><property>fcs/elevator-cmd-norm</property><property>fcs/rudder-cmd-norm</property><property>fcs/throttle-cmd-norm</property><property>fcs/effective-aileron-pos-deg</property><property>fcs/elevator-pos-deg</property><property>aero/alpha-deg</property><property>aero/beta-deg</property><property>aero/qbar-area</property><property>aero/coefficient/CL_base</property><property>aero/coefficient/CL_de</property><property>aero/coefficient/CD_base</property><property>aero/coefficient/CD_de</property><property>aero/coefficient/CY_beta</property><property>aero/coefficient/Cl_beta</property><property>aero/coefficient/Cl_da</property><property>aero/coefficient/Cm_base</property><property>aero/coefficient/Cm_de</property><property>aero/coefficient/Cn_beta</property><property>aero/coefficient/Cn_da</property><property>forces/fbx-aero-lbs</property><property>forces/fby-aero-lbs</property><property>forces/fbz-aero-lbs</property><property>moments/l-aero-lbsft</property><property>moments/m-aero-lbsft</property><property>moments/n-aero-lbsft</property><property>fcs/cmdEscFR_nd</property><property>fcs/cmdEscAL_nd</property><property>fcs/cmdEscFL_nd</property><property>fcs/cmdEscAR_nd</property><property>propulsion/engine/thrust-lbs</property><property>propulsion/engine[1]/thrust-lbs</property><property>propulsion/engine[2]/thrust-lbs</property><property>propulsion/engine[3]/thrust-lbs</property>
  </output>
</runscript>
