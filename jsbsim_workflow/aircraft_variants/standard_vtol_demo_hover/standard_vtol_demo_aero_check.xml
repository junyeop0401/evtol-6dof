<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="http://jsbsim.sf.net/JSBSimScript.xsl"?>
<runscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://jsbsim.sf.net/JSBSimScript.xsd" name="standard_vtol_demo DATCOM aero data check">
  <use aircraft="standard_vtol_demo" initialize="initAir"/>
  <run start="0.0" end="0.10" dt="0.01">
    <property value="0.0">simulation/notify-time-trigger</property>
    <event name="Set aero sample controls">
      <condition>simulation/sim-time-sec ge 0.01</condition>
      <set name="fcs/aileron-cmd-norm" value="0.5"/>
      <set name="fcs/elevator-cmd-norm" value="0.0"/>
      <set name="fcs/rudder-cmd-norm" value="0.0"/>
    </event>
    <event name="Aero notify" persistent="true">
      <condition>simulation/sim-time-sec ge simulation/notify-time-trigger</condition>
      <notify>
        <property>simulation/sim-time-sec</property>
        <property>aero/alpha-deg</property>
        <property>velocities/mach</property>
        <property>fcs/effective-aileron-pos-deg</property>
        <property>aero/coefficient/CL_base</property>
        <property>aero/coefficient/CD_base</property>
        <property>aero/coefficient/Cm_base</property>
        <property>aero/coefficient/Cl_da</property>
        <property>aero/coefficient/Cn_da</property>
      </notify>
      <set name="simulation/notify-time-trigger" value="0.05" type="FG_DELTA"/>
    </event>
  </run>
  <output name="standard_vtol_demo_aero_check.csv" type="CSV" rate="100">
    <property>simulation/sim-time-sec</property>
    <property>aero/alpha-deg</property>
    <property>velocities/mach</property>
    <property>fcs/effective-aileron-pos-deg</property>
    <property>aero/coefficient/CL_base</property>
    <property>aero/coefficient/CD_base</property>
    <property>aero/coefficient/Cm_base</property>
    <property>aero/coefficient/Cl_da</property>
    <property>aero/coefficient/Cn_da</property>
  </output>
</runscript>
