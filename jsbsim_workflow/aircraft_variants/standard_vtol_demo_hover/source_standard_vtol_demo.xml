  <!-- fcs/esc-cmd-norm[N] 은 cmd 입력용 프로퍼티 (Python set_jsbsim_property 용).
       fcs/esc-out[N] 은 external_reactions 에서 선언 (quadrotor_x 패턴 참조).
       ProjectAirSim jsbsim-physics 는 actuator name = fcs/esc-out[N] 일 때
       스로틀 값을 해당 프로퍼티에 직접 써서 external_reactions 힘 테이블을 구동함. -->
  <system name="fcs">
    <property value="0.0">fcs/esc-cmd-norm[0]</property>
    <property value="0.0">fcs/esc-cmd-norm[1]</property>
    <property value="0.0">fcs/esc-cmd-norm[2]</property>
    <property value="0.0">fcs/esc-cmd-norm[3]</property>
    <property value="0.0">fcs/esc-cmd-norm[4]</property>

    <!-- Lift motors 0-3: map PX4/ProjectAirSim throttle (esc-cmd-norm) to esc-out.
         Without these channels esc-out[0..3] stays 0, so the external_reactions
         lift-force tables and the visual props never receive throttle
         (quadrotor_x.xml has the equivalent Motor_0..Motor_3 channels). -->
    <channel name="LiftMotor0">
      <actuator name="fcs/etc/esc_0">
        <input>fcs/esc-cmd-norm[0]</input>
        <clipto>
          <min>0.0</min>
          <max>1.0</max>
        </clipto>
        <output>fcs/esc-out[0]</output>
      </actuator>
    </channel>
    <channel name="LiftMotor1">
      <actuator name="fcs/etc/esc_1">
        <input>fcs/esc-cmd-norm[1]</input>
        <clipto>
          <min>0.0</min>
          <max>1.0</max>
        </clipto>
        <output>fcs/esc-out[1]</output>
      </actuator>
    </channel>
    <channel name="LiftMotor2">
      <actuator name="fcs/etc/esc_2">
        <input>fcs/esc-cmd-norm[2]</input>
        <clipto>
          <min>0.0</min>
          <max>1.0</max>
        </clipto>
        <output>fcs/esc-out[2]</output>
      </actuator>
    </channel>
    <channel name="LiftMotor3">
      <actuator name="fcs/etc/esc_3">
        <input>fcs/esc-cmd-norm[3]</input>
        <clipto>
          <min>0.0</min>
          <max>1.0</max>
        </clipto>
        <output>fcs/esc-out[3]</output>
      </actuator>
    </channel>

    <channel name="PusherMotor">
      <actuator name="fcs/etc/esc_4">
        <input>fcs/esc-cmd-norm[4]</input>
        <clipto>
          <min>0.0</min>
          <max>1.0</max>
        </clipto>
        <output>fcs/esc-out[4]</output>
      </actuator>
    </channel>

    <property value="0.0">fcs/motor_torque[0]</property>
    <property value="0.0">fcs/motor_torque[1]</property>
    <property value="0.0">fcs/motor_torque[2]</property>
    <property value="0.0">fcs/motor_torque[3]</property>
    <channel name="Motor0Torque">
      <fcs_function>
        <function>
          <product>
            <table>
              <independentVar>fcs/esc-out[0]</independentVar>
              <tableData>
                0.0 0.0
                0.5 0.05
                0.7 0.10
                1.0 0.25
              </tableData>
            </table>
            <value>1.0</value>
          </product>
        </function>
        <output>fcs/motor_torque[0]</output>
      </fcs_function>
    </channel>
    <channel name="Motor1Torque">
      <fcs_function>
        <function>
          <product>
            <table>
              <independentVar>fcs/esc-out[1]</independentVar>
              <tableData>
                0.0 0.0
                0.5 0.05
                0.7 0.10
                1.0 0.25
              </tableData>
            </table>
            <value>1.0</value>
          </product>
        </function>
        <output>fcs/motor_torque[1]</output>
      </fcs_function>
    </channel>
    <channel name="Motor2Torque">
      <fcs_function>
        <function>
          <product>
            <table>
              <independentVar>fcs/esc-out[2]</independentVar>
              <tableData>
                0.0 0.0
                0.5 0.05
                0.7 0.10
                1.0 0.25
              </tableData>
            </table>
            <value>-1.0</value>
          </product>
        </function>
        <output>fcs/motor_torque[2]</output>
      </fcs_function>
    </channel>
    <channel name="Motor3Torque">
      <fcs_function>
        <function>
          <product>
            <table>
              <independentVar>fcs/esc-out[3]</independentVar>
              <tableData>
                0.0 0.0
                0.5 0.05
                0.7 0.10
                1.0 0.25
              </tableData>
            </table>
            <value>-1.0</value>
          </product>
        </function>
        <output>fcs/motor_torque[3]</output>
      </fcs_function>
    </channel>
    <channel name="NetMotorTorque">
      <fcs_function>
        <function>
          <sum>
            <property>fcs/motor_torque[0]</property>
            <property>fcs/motor_torque[1]</property>
            <property>fcs/motor_torque[2]</property>
            <property>fcs/motor_torque[3]</property>
          </sum>
        </function>
        <output>fcs/net_torque</output>
      </fcs_function>
    </channel>
  </system>

  <flight_control name="standard_vtol_demo">
    <channel name="Roll">
      <summer name="fcs/aileron-sum">
        <input>fcs/aileron-cmd-norm</input>
        <clipto>
          <min>-1</min>
          <max>1</max>
        </clipto>
      </summer>
      <aerosurface_scale name="fcs/left-aileron-control">
        <input>fcs/aileron-sum</input>
        <range>
          <min>-25</min>
          <max>25</max>
        </range>
        <gain>0.0174533</gain>
      </aerosurface_scale>
      <actuator name="fcs/left-aileron-actuator">
        <input>fcs/left-aileron-control</input>
        <clipto>
          <min>-0.4363</min>
          <max>0.4363</max>
        </clipto>
        <output>fcs/left-aileron-pos-rad</output>
      </actuator>
      <aerosurface_scale name="fcs/right-aileron-control">
        <input>fcs/aileron-sum</input>
        <range>
          <min>-25</min>
          <max>25</max>
        </range>
        <gain>0.0174533</gain>
      </aerosurface_scale>
      <actuator name="fcs/right-aileron-actuator">
        <input>fcs/right-aileron-control</input>
        <clipto>
          <min>-0.4363</min>
          <max>0.4363</max>
        </clipto>
        <output>fcs/right-aileron-pos-rad</output>
      </actuator>
      <summer name="fcs/effective-aileron-pos">
        <input>fcs/left-aileron-pos-rad</input>
        <input>fcs/right-aileron-pos-rad</input>
        <gain>0.5</gain>
      </summer>
    </channel>

    <channel name="Pitch">
      <summer name="fcs/elevator-sum">
        <input>fcs/elevator-cmd-norm</input>
        <clipto>
          <min>-1</min>
          <max>1</max>
        </clipto>
      </summer>
      <aerosurface_scale name="fcs/elevator-control">
        <input>fcs/elevator-sum</input>
        <range>
          <min>-25</min>
          <max>25</max>
        </range>
        <gain>0.0174533</gain>
      </aerosurface_scale>
      <actuator name="fcs/elevator-actuator">
        <input>fcs/elevator-control</input>
        <clipto>
          <min>-0.4363</min>
          <max>0.4363</max>
        </clipto>
        <output>fcs/elevator-pos-rad</output>
      </actuator>
      <fcs_function name="fcs/mag-elevator-pos-rad">
        <function>
          <abs>
            <property>fcs/elevator-pos-rad</property>
          </abs>
        </function>
      </fcs_function>
    </channel>

    <channel name="Yaw">
      <summer name="fcs/rudder-sum">
        <input>fcs/rudder-cmd-norm</input>
        <clipto>
          <min>-1</min>
          <max>1</max>
        </clipto>
      </summer>
      <aerosurface_scale name="fcs/rudder-control">
        <input>fcs/rudder-sum</input>
        <range>
          <min>-25</min>
          <max>25</max>
        </range>
        <gain>0.0174533</gain>
      </aerosurface_scale>
      <actuator name="fcs/rudder-actuator">
        <input>fcs/rudder-control</input>
        <clipto>
          <min>-0.4363</min>
          <max>0.4363</max>
        </clipto>
        <output>fcs/rudder-pos-rad</output>
      </actuator>
    </channel>
  </flight_control>

  <external_reactions>
    <!-- fcs/esc-out[N] 을 external_reactions 안에 선언해야
         ProjectAirSim jsbsim-physics 가 스로틀 값을 이 프로퍼티에 주입할 수 있음.
         (quadrotor_x.xml 패턴 동일하게 적용)
         JSBSim force table: 스로틀 0-1 → 추력 lbf.
         AD3000 23.6 kg = 52.0 lbf.
         호버 ~0.586 스로틀 (4 * 13.0 lbf = 52.0 lbf),
         T/W ~2.9 at 1.0 스로틀 (4 * 37.8 = 151 lbf, 최대). [2026-07-21] 질량 23.6kg에 맞춰 재스케일. -->
    <property value="0.0">fcs/esc-out[0]</property>
    <property value="0.0">fcs/esc-out[1]</property>
    <property value="0.0">fcs/esc-out[2]</property>
    <property value="0.0">fcs/esc-out[3]</property>
    <property value="0.0">fcs/esc-out[4]</property>
    <force name="MOTOR_0_LIFT_FR" frame="BODY">
      <function>
        <table>
          <independentVar>fcs/esc-out[0]</independentVar>
          <tableData>
            0.0 0.0
            0.5 9.45
            0.7 18.5
            1.0 37.8
          </tableData>
        </table>
      </function>
      <location unit="M">
        <!-- [2026-07-24] AD3000 real rotor arm (CAD): was +-0.20 m demo value.
             Must match PX4 CA_ROTOR0_PX/PY (0.754/1.163) or the control
             allocator overestimates torque authority ~5x (measured rate-loop
             tracking failure, ulog 12_32_24). Structural frame: x aft+. -->
        <x>-0.754</x>
        <y>1.163</y>
        <z>0.05</z>
      </location>
      <direction>
        <x>0.0</x>
        <y>0.0</y>
        <z>-1.0</z>
      </direction>
    </force>

    <force name="MOTOR_1_LIFT_RL" frame="BODY">
      <function>
        <table>
          <independentVar>fcs/esc-out[1]</independentVar>
          <tableData>
            0.0 0.0
            0.5 9.45
            0.7 18.5
            1.0 37.8
          </tableData>
        </table>
      </function>
      <location unit="M">
        <x>0.755</x>
        <y>-1.163</y>
        <z>0.05</z>
      </location>
      <direction>
        <x>0.0</x>
        <y>0.0</y>
        <z>-1.0</z>
      </direction>
    </force>

    <force name="MOTOR_2_LIFT_FL" frame="BODY">
      <function>
        <table>
          <independentVar>fcs/esc-out[2]</independentVar>
          <tableData>
            0.0 0.0
            0.5 9.45
            0.7 18.5
            1.0 37.8
          </tableData>
        </table>
      </function>
      <location unit="M">
        <x>-0.754</x>
        <y>-1.163</y>
        <z>0.05</z>
      </location>
      <direction>
        <x>0.0</x>
        <y>0.0</y>
        <z>-1.0</z>
      </direction>
    </force>

    <force name="MOTOR_3_LIFT_RR" frame="BODY">
      <function>
        <table>
          <independentVar>fcs/esc-out[3]</independentVar>
          <tableData>
            0.0 0.0
            0.5 9.45
            0.7 18.5
            1.0 37.8
          </tableData>
        </table>
      </function>
      <location unit="M">
        <x>0.755</x>
        <y>1.163</y>
        <z>0.05</z>
      </location>
      <direction>
        <x>0.0</x>
        <y>0.0</y>
        <z>-1.0</z>
      </direction>
    </force>

    <force name="PUSHER_THRUST" frame="BODY">
      <function>
        <description>
          [AD3000 / 2026-07-30] Pusher thrust = throttle table * forward-speed decay.
          WAS max 4.8 lbf (21 N) - a leftover 5 kg-demo value; measured forward
          accel in ulg 04_19_58 was only 1.15 m/s2 (0.12 g) with the pusher
          saturated, so the aircraft could never reach transition speed.
          HV-3000-210KV on 12S with a 20 in prop: ~105 N (23.5 lbf) static,
          decaying with advance ratio. Static T/W = 0.45. Replace with BEMT.
        </description>
        <product>
          <table>
            <independentVar>fcs/esc-out[4]</independentVar>
            <tableData>
              0.0   0.00
              0.2   3.70
              0.4   8.50
              0.6  13.60
              0.8  18.70
              1.0  23.50
            </tableData>
          </table>
          <table>
            <independentVar>velocities/vt-fps</independentVar>
            <tableData>
                0.0  1.00
               32.8  0.88
               65.6  0.73
               98.4  0.54
              131.2  0.28
              164.0  0.02
            </tableData>
          </table>
        </product>
      </function>
      <location unit="M">
        <x>1.60</x>
        <y>0.0</y>
        <z>0.0</z>
      </location>
      <direction>
        <x>1.0</x>
        <y>0.0</y>
        <z>0.0</z>
      </direction>
    </force>
  </external_reactions>

  <aerodynamics>
    <!-- ==================================================================
         [AD3000 / 2026-07-30] Full-envelope aero, CAD planform.
           attached flow : CL = 0.25 + 5.0*alpha,  CD = 0.045 + CL^2/(pi*0.85*10.03)
           blended into a flat plate past ~11.5 deg so 0..90 deg (transition)
           stays finite - CLmax 1.32 @ 14 deg.
         Predicted (MTOW 23.6 kg, S 0.953 m2):
           V_stall 17.4 m/s | V(L/Dmax) 19.0 m/s, (L/D)max 12.2 | cruise 22-24 m/s
         WAS: CL0 0.05 + 3.2*alpha, no stall, S 0.75 m2 -> lift ~1% of weight
         at 10 m/s, which is exactly what ulg 04_19_58 measured.

         [2026-07-30 b] ELEVATOR SIGN FIX. Cmde was NEGATIVE (JSBSim convention:
         positive elevator = trailing edge down = nose down), but PX4 drives
         fcs/elevator-cmd-norm straight from the control allocator, where
         CA_SV_CS1_TRQ_P = +1 means "positive servo = positive (nose-up) pitch
         torque". So every PX4 pitch command was inverted. Latent until the
         first successful FW entry (ulg 06_37_21): the aircraft pitched up at
         46 deg/s against a nose-down command, alpha hit 36 deg, it departed
         and quad-chuted on roll > 60 deg. Cmde is now POSITIVE and CLde
         NEGATIVE (nose-up elevator unloads the tail -> total lift decreases).
         Aileron (Clda +) and rudder (Cndr +) were already correct - verified
         against PX4 CA_SV_CS0_TRQ_R / CA_SV_CS2_TRQ_Y.
         ================================================================== -->
