            name="standard_vtol_demo_hover_demo_main"
            version="2.0"
            release="ALPHA"
            xsi:noNamespaceSchemaLocation="http://jsbsim.sourceforge.net/JSBSim.xsd">
  <fileheader>
    <author>IAMAI / Codex demo scaffold</author>
    <filecreationdate>2026-05-06</filecreationdate>
    <version>0.1</version>
    <description>standard_vtol_demo_hover_demo_main modular JSBSim standalone model.</description>
