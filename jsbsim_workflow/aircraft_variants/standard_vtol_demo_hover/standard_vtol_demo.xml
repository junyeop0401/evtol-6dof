<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://jsbsim.sourceforge.net/JSBSim.xsl"?>
<fdm_config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            name="standard_vtol_demo_hover"
            version="2.0"
            release="ALPHA"
            xsi:noNamespaceSchemaLocation="http://jsbsim.sourceforge.net/JSBSim.xsd">
  <fileheader>
    <author>IAMAI / Codex demo scaffold</author>
    <filecreationdate>2026-05-06</filecreationdate>
    <version>0.1</version>
    <description>Demo 4-lift-motor plus pusher standard VTOL model for Project AirSim JSBSim integration.</description>
    <note>
      This is a deliberately simplified integration model. It is intended to prove
      Project AirSim, JSBSim, Unreal visualization, and PX4 Standard VTOL actuator
      wiring before replacing the aero/propulsion/mass data with validated DT
      Simulator databases.
    </note>

    <note>
      JSBSim standalone conversion: fcs/motor-armed gates all five motor commands,
      and the aerodynamic block can be swapped between the original demo aero and
      the DATCOM-derived jsbsim_aerodynamic_database.xml block.
    </note>
  </fileheader>

  <metrics>
    <!-- [AD3000 / 2026-07-30] CAD-measured planform.
         Wing skin STEP bbox per span station: root chord 0.355 m -> tip 0.275 m,
         half-span 1.546 m (spec sheet), tip cap rounds to 0.183 m.
         Integrated  S = 0.953 m2,  MAC = S/b = 0.308 m,  AR = b^2/S = 10.03.
         WAS 0.75 m2 / 2.10 m span (demo aircraft) with AD3000's 23.6 kg mass
         -> wing loading 309 N/m2 and stall ~24 m/s, while PX4 was told to
         transition at 10 m/s. That mismatch is the root cause of the
         "no lift during transition" quad-chute (ulg 04_19_58). -->
    <wingarea unit="M2">0.953</wingarea>
    <wingspan unit="M">3.092</wingspan>
    <chord unit="M">0.308</chord>
    <htailarea unit="M2">0.100</htailarea>
    <htailarm unit="M">1.450</htailarm>
    <vtailarea unit="M2">0.060</vtailarea>
    <vtailarm unit="M">1.450</vtailarm>
    <location name="AERORP" unit="M">
      <x>0.0</x>
      <y>0.0</y>
      <z>0.0</z>
    </location>
    <location name="EYEPOINT" unit="M">
      <x>0.15</x>
      <y>0.0</y>
      <z>-0.05</z>
    </location>
    <location name="VRP" unit="M">
      <x>0.0</x>
      <y>0.0</y>
      <z>0.0</z>
    </location>
  </metrics>

  <mass_balance>
    <!-- AD3000 placeholder mass/inertia (matches robot config + rotor thrust; MTOW 23.6 kg).
         WAS 5.0 kg / 0.15-0.25 -> caused TWR ~13 and uncommanded launch. -->
    <ixx unit="KG*M2">10.7000</ixx>
    <iyy unit="KG*M2">8.0000</iyy>
    <izz unit="KG*M2">18.5000</izz>
    <emptywt unit="KG">23.6</emptywt>
    <location name="CG" unit="M">
      <x>0.0</x>
      <y>0.0</y>
      <z>0.0</z>
    </location>
  </mass_balance>

  <ground_reactions>
    <contact type="BOGEY" name="front_foot">
      <location unit="M">
        <x>0.60</x>
        <y>0.00</y>
        <z>-0.18</z>
      </location>
      <static_friction>0.7</static_friction>
      <dynamic_friction>0.5</dynamic_friction>
      <rolling_friction>0.05</rolling_friction>
      <spring_coeff unit="LBS/FT">600</spring_coeff>
      <damping_coeff unit="LBS/FT/SEC">20</damping_coeff>
      <max_steer unit="DEG">0.0</max_steer>
      <brake_group>NONE</brake_group>
    </contact>
    <contact type="BOGEY" name="rear_left_foot">
      <location unit="M">
        <x>-0.60</x>
        <y>-2.00</y>
        <z>-0.18</z>
      </location>
      <static_friction>0.7</static_friction>
      <dynamic_friction>0.5</dynamic_friction>
      <rolling_friction>0.05</rolling_friction>
      <spring_coeff unit="LBS/FT">300</spring_coeff>
      <damping_coeff unit="LBS/FT/SEC">12</damping_coeff>
      <max_steer unit="DEG">0.0</max_steer>
      <brake_group>NONE</brake_group>
    </contact>
    <contact type="BOGEY" name="rear_right_foot">
      <location unit="M">
        <x>-0.60</x>
        <y>2.00</y>
        <z>-0.18</z>
      </location>
      <static_friction>0.7</static_friction>
      <dynamic_friction>0.5</dynamic_friction>
      <rolling_friction>0.05</rolling_friction>
      <spring_coeff unit="LBS/FT">300</spring_coeff>
      <damping_coeff unit="LBS/FT/SEC">12</damping_coeff>
      <max_steer unit="DEG">0.0</max_steer>
      <brake_group>NONE</brake_group>
    </contact>
  </ground_reactions>

  <!-- fcs/esc-cmd-norm[N] 은 cmd 입력용 프로퍼티 (Python set_jsbsim_property 용).
       fcs/esc-out[N] 은 external_reactions 에서 선언 (quadrotor_x 패턴 참조).
       ProjectAirSim jsbsim-physics 는 actuator name = fcs/esc-out[N] 일 때
       스로틀 값을 해당 프로퍼티에 직접 써서 external_reactions 힘 테이블을 구동함. -->
  <system name="fcs">
    <property value="0.0">fcs/motor-armed</property>
    <property value="0.0">fcs/hover-collective-cmd-norm</property>
    <property value="0.0">fcs/hover-manual-collective-cmd-norm</property>
    <property value="0.0">fcs/hover-altitude-enable</property>
    <property value="0.0">fcs/hover-altitude-target-ft</property>
    <property value="0.578">fcs/hover-throttle-base-norm</property>
    <property value="0.0">fcs/esc-cmd-norm[0]</property>
    <property value="0.0">fcs/esc-cmd-armed[0]</property>
    <property value="0.0">fcs/esc-cmd-norm[1]</property>
    <property value="0.0">fcs/esc-cmd-armed[1]</property>
    <property value="0.0">fcs/esc-cmd-norm[2]</property>
    <property value="0.0">fcs/esc-cmd-armed[2]</property>
    <property value="0.0">fcs/esc-cmd-norm[3]</property>
    <property value="0.0">fcs/esc-cmd-armed[3]</property>
    <property value="0.0">fcs/esc-cmd-norm[4]</property>
    <property value="0.0">fcs/esc-cmd-armed[4]</property>


    <channel name="HoverAltitudeController">
      <summer name="fcs/hover-altitude-error-ft">
        <input>fcs/hover-altitude-target-ft</input>
        <input>-position/h-agl-ft</input>
        <clipto><min>-20.0</min><max>20.0</max></clipto>
      </summer>
      <pure_gain name="fcs/hover-altitude-p-norm">
        <input>fcs/hover-altitude-error-ft</input>
        <gain>0.006</gain>
      </pure_gain>
      <pure_gain name="fcs/hover-vertical-rate-d-norm">
        <input>velocities/h-dot-fps</input>
        <gain>-0.015</gain>
        <clipto><min>-0.120</min><max>0.120</max></clipto>
      </pure_gain>
      <summer name="fcs/hover-altitude-collective-raw-norm">
        <input>fcs/hover-throttle-base-norm</input>
        <input>fcs/hover-altitude-p-norm</input>
        <input>fcs/hover-vertical-rate-d-norm</input>
        <clipto><min>0.430</min><max>0.680</max></clipto>
      </summer>
      <switch name="fcs/hover-collective-cmd-norm">
        <default value="fcs/hover-manual-collective-cmd-norm"/>
        <test value="fcs/hover-altitude-collective-raw-norm">
          fcs/hover-altitude-enable eq 1
        </test>
      </switch>
    </channel>

    <!-- JSBSim standalone hover attitude mixer. Mission scripts command only fcs/hover-collective-cmd-norm. -->
    <channel name="HoverAttitudeController">
      <pure_gain name="fcs/hover-roll-att-cmd-norm">
        <input>attitude/phi-rad</input>
        <gain>-0.080</gain>
      </pure_gain>
      <pure_gain name="fcs/hover-roll-rate-cmd-norm">
        <input>velocities/p-aero-rad_sec</input>
        <gain>-0.030</gain>
      </pure_gain>
      <summer name="fcs/hover-roll-mix-norm">
        <input>fcs/hover-roll-att-cmd-norm</input>
        <input>fcs/hover-roll-rate-cmd-norm</input>
        <clipto><min>-0.080</min><max>0.080</max></clipto>
      </summer>
      <pure_gain name="fcs/hover-pitch-att-cmd-norm">
        <input>attitude/theta-rad</input>
        <gain>-0.080</gain>
      </pure_gain>
      <pure_gain name="fcs/hover-pitch-rate-cmd-norm">
        <input>velocities/q-aero-rad_sec</input>
        <gain>-0.030</gain>
      </pure_gain>
      <summer name="fcs/hover-pitch-mix-norm">
        <input>fcs/hover-pitch-att-cmd-norm</input>
        <input>fcs/hover-pitch-rate-cmd-norm</input>
        <clipto><min>-0.080</min><max>0.080</max></clipto>
      </summer>
      <pure_gain name="fcs/hover-yaw-rate-mix-norm">
        <input>velocities/r-aero-rad_sec</input>
        <gain>-0.020</gain>
        <clipto><min>-0.040</min><max>0.040</max></clipto>
      </pure_gain>
      <summer name="fcs/esc-cmd-norm[0]">
        <input>fcs/hover-collective-cmd-norm</input>
        <input>-fcs/hover-roll-mix-norm</input>
        <input>fcs/hover-pitch-mix-norm</input>
        <input>fcs/hover-yaw-rate-mix-norm</input>
        <clipto><min>0.0</min><max>1.0</max></clipto>
      </summer>
      <summer name="fcs/esc-cmd-norm[1]">
        <input>fcs/hover-collective-cmd-norm</input>
        <input>fcs/hover-roll-mix-norm</input>
        <input>-fcs/hover-pitch-mix-norm</input>
        <input>fcs/hover-yaw-rate-mix-norm</input>
        <clipto><min>0.0</min><max>1.0</max></clipto>
      </summer>
      <summer name="fcs/esc-cmd-norm[2]">
        <input>fcs/hover-collective-cmd-norm</input>
        <input>fcs/hover-roll-mix-norm</input>
        <input>fcs/hover-pitch-mix-norm</input>
        <input>-fcs/hover-yaw-rate-mix-norm</input>
        <clipto><min>0.0</min><max>1.0</max></clipto>
      </summer>
      <summer name="fcs/esc-cmd-norm[3]">
        <input>fcs/hover-collective-cmd-norm</input>
        <input>-fcs/hover-roll-mix-norm</input>
        <input>-fcs/hover-pitch-mix-norm</input>
        <input>-fcs/hover-yaw-rate-mix-norm</input>
        <clipto><min>0.0</min><max>1.0</max></clipto>
      </summer>
    </channel>

    <!-- JSBSim standalone arming gate: commands are ignored until fcs/motor-armed == 1. -->
    <channel name="MotorArmingGate">
      <fcs_function>
        <function><product><property>fcs/esc-cmd-norm[0]</property><property>fcs/motor-armed</property></product></function>
        <output>fcs/esc-cmd-armed[0]</output>
      </fcs_function>
      <fcs_function>
        <function><product><property>fcs/esc-cmd-norm[1]</property><property>fcs/motor-armed</property></product></function>
        <output>fcs/esc-cmd-armed[1]</output>
      </fcs_function>
      <fcs_function>
        <function><product><property>fcs/esc-cmd-norm[2]</property><property>fcs/motor-armed</property></product></function>
        <output>fcs/esc-cmd-armed[2]</output>
      </fcs_function>
      <fcs_function>
        <function><product><property>fcs/esc-cmd-norm[3]</property><property>fcs/motor-armed</property></product></function>
        <output>fcs/esc-cmd-armed[3]</output>
      </fcs_function>
      <fcs_function>
        <function><product><property>fcs/esc-cmd-norm[4]</property><property>fcs/motor-armed</property></product></function>
        <output>fcs/esc-cmd-armed[4]</output>
      </fcs_function>
    </channel>

    <!-- Lift motors 0-3: map PX4/ProjectAirSim throttle (esc-cmd-norm) to esc-out.
         Without these channels esc-out[0..3] stays 0, so the external_reactions
         lift-force tables and the visual props never receive throttle
         (quadrotor_x.xml has the equivalent Motor_0..Motor_3 channels). -->
    <channel name="LiftMotor0">
      <actuator name="fcs/etc/esc_0">
        <input>fcs/esc-cmd-armed[0]</input>
        <clipto>
          <min>0.0</min>
          <max>1.0</max>
        </clipto>
        <output>fcs/esc-out[0]</output>
      </actuator>
    </channel>
    <channel name="LiftMotor1">
      <actuator name="fcs/etc/esc_1">
        <input>fcs/esc-cmd-armed[1]</input>
        <clipto>
          <min>0.0</min>
          <max>1.0</max>
        </clipto>
        <output>fcs/esc-out[1]</output>
      </actuator>
    </channel>
    <channel name="LiftMotor2">
      <actuator name="fcs/etc/esc_2">
        <input>fcs/esc-cmd-armed[2]</input>
        <clipto>
          <min>0.0</min>
          <max>1.0</max>
        </clipto>
        <output>fcs/esc-out[2]</output>
      </actuator>
    </channel>
    <channel name="LiftMotor3">
      <actuator name="fcs/etc/esc_3">
        <input>fcs/esc-cmd-armed[3]</input>
        <clipto>
          <min>0.0</min>
          <max>1.0</max>
        </clipto>
        <output>fcs/esc-out[3]</output>
      </actuator>
    </channel>

    <channel name="PusherMotor">
      <actuator name="fcs/etc/esc_4">
        <input>fcs/esc-cmd-armed[4]</input>
        <clipto>
          <min>0.0</min>
          <max>1.0</max>
        </clipto>
        <output>fcs/esc-out[4]</output>
      </actuator>
    </channel>

    <property value="0.0">fcs/motor_torque[0]</property>
    <property value="0.0">fcs/motor_torque[1]</property>
    <property value="0.0">fcs/motor_torque[2]</property>
    <property value="0.0">fcs/motor_torque[3]</property>
    <channel name="Motor0Torque">
      <fcs_function>
        <function>
          <product>
            <table>
              <independentVar>fcs/esc-out[0]</independentVar>
              <tableData>
                0.0 0.0
                0.5 0.05
                0.7 0.10
                1.0 0.25
              </tableData>
            </table>
            <value>1.0</value>
          </product>
        </function>
        <output>fcs/motor_torque[0]</output>
      </fcs_function>
    </channel>
    <channel name="Motor1Torque">
      <fcs_function>
        <function>
          <product>
            <table>
              <independentVar>fcs/esc-out[1]</independentVar>
              <tableData>
                0.0 0.0
                0.5 0.05
                0.7 0.10
                1.0 0.25
              </tableData>
            </table>
            <value>1.0</value>
          </product>
        </function>
        <output>fcs/motor_torque[1]</output>
      </fcs_function>
    </channel>
    <channel name="Motor2Torque">
      <fcs_function>
        <function>
          <product>
            <table>
              <independentVar>fcs/esc-out[2]</independentVar>
              <tableData>
                0.0 0.0
                0.5 0.05
                0.7 0.10
                1.0 0.25
              </tableData>
            </table>
            <value>-1.0</value>
          </product>
        </function>
        <output>fcs/motor_torque[2]</output>
      </fcs_function>
    </channel>
    <channel name="Motor3Torque">
      <fcs_function>
        <function>
          <product>
            <table>
              <independentVar>fcs/esc-out[3]</independentVar>
              <tableData>
                0.0 0.0
                0.5 0.05
                0.7 0.10
                1.0 0.25
              </tableData>
            </table>
            <value>-1.0</value>
          </product>
        </function>
        <output>fcs/motor_torque[3]</output>
      </fcs_function>
    </channel>
    <channel name="NetMotorTorque">
      <fcs_function>
        <function>
          <sum>
            <property>fcs/motor_torque[0]</property>
            <property>fcs/motor_torque[1]</property>
            <property>fcs/motor_torque[2]</property>
            <property>fcs/motor_torque[3]</property>
          </sum>
        </function>
        <output>fcs/net_torque</output>
      </fcs_function>
    </channel>
  </system>

  <flight_control name="standard_vtol_demo">
    <channel name="Roll">
      <summer name="fcs/aileron-sum">
        <input>fcs/aileron-cmd-norm</input>
        <clipto>
          <min>-1</min>
          <max>1</max>
        </clipto>
      </summer>
      <aerosurface_scale name="fcs/left-aileron-control">
        <input>fcs/aileron-sum</input>
        <range>
          <min>-25</min>
          <max>25</max>
        </range>
        <gain>0.0174533</gain>
      </aerosurface_scale>
      <actuator name="fcs/left-aileron-actuator">
        <input>fcs/left-aileron-control</input>
        <clipto>
          <min>-0.4363</min>
          <max>0.4363</max>
        </clipto>
        <output>fcs/left-aileron-pos-rad</output>
      </actuator>
      <aerosurface_scale name="fcs/right-aileron-control">
        <input>fcs/aileron-sum</input>
        <range>
          <min>-25</min>
          <max>25</max>
        </range>
        <gain>0.0174533</gain>
      </aerosurface_scale>
      <actuator name="fcs/right-aileron-actuator">
        <input>fcs/right-aileron-control</input>
        <clipto>
          <min>-0.4363</min>
          <max>0.4363</max>
        </clipto>
        <output>fcs/right-aileron-pos-rad</output>
      </actuator>
      <summer name="fcs/effective-aileron-pos">
        <input>fcs/left-aileron-pos-rad</input>
        <input>fcs/right-aileron-pos-rad</input>
        <gain>0.5</gain>
      </summer>
      <pure_gain name="fcs/effective-aileron-rad-to-deg">
        <input>fcs/effective-aileron-pos</input>
        <gain>57.295779513082</gain>
        <output>fcs/effective-aileron-pos-deg</output>
      </pure_gain>
    </channel>

    <channel name="Pitch">
      <summer name="fcs/elevator-sum">
        <input>fcs/elevator-cmd-norm</input>
        <clipto>
          <min>-1</min>
          <max>1</max>
        </clipto>
      </summer>
      <aerosurface_scale name="fcs/elevator-control">
        <input>fcs/elevator-sum</input>
        <range>
          <min>-25</min>
          <max>25</max>
        </range>
        <gain>0.0174533</gain>
      </aerosurface_scale>
      <actuator name="fcs/elevator-actuator">
        <input>fcs/elevator-control</input>
        <clipto>
          <min>-0.4363</min>
          <max>0.4363</max>
        </clipto>
        <output>fcs/elevator-pos-rad</output>
      </actuator>
      <fcs_function name="fcs/mag-elevator-pos-rad">
        <function>
          <abs>
            <property>fcs/elevator-pos-rad</property>
          </abs>
        </function>
      </fcs_function>
    </channel>

    <channel name="Yaw">
      <summer name="fcs/rudder-sum">
        <input>fcs/rudder-cmd-norm</input>
        <clipto>
          <min>-1</min>
          <max>1</max>
        </clipto>
      </summer>
      <aerosurface_scale name="fcs/rudder-control">
        <input>fcs/rudder-sum</input>
        <range>
          <min>-25</min>
          <max>25</max>
        </range>
        <gain>0.0174533</gain>
      </aerosurface_scale>
      <actuator name="fcs/rudder-actuator">
        <input>fcs/rudder-control</input>
        <clipto>
          <min>-0.4363</min>
          <max>0.4363</max>
        </clipto>
        <output>fcs/rudder-pos-rad</output>
      </actuator>
    </channel>
  </flight_control>

  <external_reactions>
    <!-- fcs/esc-out[N] 을 external_reactions 안에 선언해야
         ProjectAirSim jsbsim-physics 가 스로틀 값을 이 프로퍼티에 주입할 수 있음.
         (quadrotor_x.xml 패턴 동일하게 적용)
         JSBSim force table: 스로틀 0-1 → 추력 lbf.
         AD3000 23.6 kg = 52.0 lbf.
         호버 ~0.586 스로틀 (4 * 13.0 lbf = 52.0 lbf),
         T/W ~2.9 at 1.0 스로틀 (4 * 37.8 = 151 lbf, 최대). [2026-07-21] 질량 23.6kg에 맞춰 재스케일. -->
    <property value="0.0">fcs/esc-out[0]</property>
    <property value="0.0">fcs/esc-out[1]</property>
    <property value="0.0">fcs/esc-out[2]</property>
    <property value="0.0">fcs/esc-out[3]</property>
    <property value="0.0">fcs/esc-out[4]</property>
    <force name="MOTOR_0_LIFT_FR" frame="BODY">
      <function>
        <table>
          <independentVar>fcs/esc-out[0]</independentVar>
          <tableData>
            0.0 0.0
            0.5 9.45
            0.7 18.5
            1.0 37.8
          </tableData>
        </table>
      </function>
      <location unit="M">
        <!-- [2026-07-24] AD3000 real rotor arm (CAD): was +-0.20 m demo value.
             Must match PX4 CA_ROTOR0_PX/PY (0.754/1.163) or the control
             allocator overestimates torque authority ~5x (measured rate-loop
             tracking failure, ulog 12_32_24). Structural frame: x aft+. -->
        <x>-0.754</x>
        <y>1.163</y>
        <z>0.05</z>
      </location>
      <direction>
        <x>0.0</x>
        <y>0.0</y>
        <z>-1.0</z>
      </direction>
    </force>

    <force name="MOTOR_1_LIFT_RL" frame="BODY">
      <function>
        <table>
          <independentVar>fcs/esc-out[1]</independentVar>
          <tableData>
            0.0 0.0
            0.5 9.45
            0.7 18.5
            1.0 37.8
          </tableData>
        </table>
      </function>
