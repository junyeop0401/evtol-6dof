<?xml version="1.0" encoding="UTF-8"?>
<runscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://jsbsim.sf.net/JSBSimScript.xsd" name="F450 origin hover diagnostic">
  <description>
    Diagnostic run for F450 hover control. Start at local (0, 0, 0), climb to
    local (0, 0, 10), hold north/east setpoints at the origin, then terminate.
  </description>
  <use aircraft="F450" initialize="initGrnd" />
  <run start="0.0" end="80.0" dt="0.002">
    <property value="0">simulation/notify-time-trigger</property>
    <property value="0">simulation/mission-state</property>
    <event name="Initialize F450 hover diagnostic">
      <condition>simulation/frame le 1</condition>
      <set name="simulation/mission-state" value="0" />
      <set name="ap/mode" value="0" />
      <set name="fcs/throttle-cmd-norm" value="0.0" />
      <set name="ap/altitude-reference" value="0" />
      <set name="ap/heading-setpoint-rad" value="0.0" />
      <set name="ap/north-setpoint-m" value="0.0" />
      <set name="ap/east-setpoint-m" value="0.0" />
      <set name="ap/altitude-setpoint-ft" value="0.55" />
    </event>
    <event name="Trim F450 ground state">
      <condition>simulation/frame gt 1</condition>
      <set name="simulation/do_simple_trim" value="2" />
    </event>
    <event name="Start hover at local origin 10 m AGL">
      <condition>simulation/sim-time-sec ge 2.0</condition>
      <set name="simulation/mission-state" value="1" />
      <set name="ap/mode" value="3" />
      <set name="ap/north-setpoint-m" value="0.0" />
      <set name="ap/east-setpoint-m" value="0.0" />
      <set name="ap/altitude-setpoint-ft" value="32.80839895" />
    </event>
    <event name="Terminate hover diagnostic">
      <condition>simulation/sim-time-sec ge 80.0</condition>
      <set name="simulation/mission-state" value="2" />
      <set name="simulation/terminate" value="1" />
    </event>
    <event name="Repeating notify" persistent="true">
      <condition>simulation/sim-time-sec ge simulation/notify-time-trigger</condition>
      <set name="simulation/notify-time-trigger" value="1.0" type="FG_DELTA" />
      <notify>
        <property>simulation/mission-state</property>
        <property>ap/mode</property>
        <property>ap/north-setpoint-m</property>
        <property>ap/east-setpoint-m</property>
        <property>ap/altitude-setpoint-ft</property>
        <property>position/h-agl-ft</property>
        <property>position/distance-from-start-lat-mt</property>
        <property>position/distance-from-start-lon-mt</property>
        <property>velocities/v-north-fps</property>
        <property>velocities/v-east-fps</property>
        <property>attitude/phi-rad</property>
        <property>attitude/theta-rad</property>
        <property>ap/hover-roll-reference-rad</property>
        <property>ap/hover-pitch-reference-rad</property>
        <property>ap/roll-cmd-norm</property>
        <property>ap/pitch-cmd-norm</property>
      </notify>
    </event>
  </run>
</runscript>
