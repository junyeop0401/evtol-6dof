<?xml version='1.0' encoding='UTF-8'?>
<runscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://jsbsim.sf.net/JSBSimScript.xsd" name="F450 10 m box hover and land mission">
  <description>
    Start at local (0, 0, 0), climb to (0, 0, 10), then visit
    (10, 0, 10), (0, 0, 10), (-10, 0, 10), (0, 0, 10),
    (0, 10, 10), (0, 0, 10), (0, -10, 10), (0, 0, 10),
    holding 5 seconds after each translation before vertical landing and disarm.
    Local x maps to north setpoint, y maps to east setpoint, z is altitude AGL. F450 uses the same schedule with heading-zero initialization.
  </description>
  <use aircraft="F450" initialize="initGrnd" />
  <run start="0.0" end="215.0" dt="0.002">
    <property value="0">simulation/notify-time-trigger</property>
    <property value="0">simulation/mission-state</property>
    <property value="0">simulation/next-event-time</property>
    <event name="Initialize and inhibit non-lift effectors">
      <condition>simulation/frame le 1</condition>
      <set name="simulation/mission-state" value="0" />
      <set name="ap/mode" value="0" />
      <set name="fcs/throttle-cmd-norm" value="0.0" />
      <set name="ap/altitude-reference" value="0" />
      <set name="ap/heading-setpoint-rad" value="0.0" />
      <set name="ap/north-setpoint-m" value="0.0" />
      <set name="ap/east-setpoint-m" value="0.0" />
      <set name="ap/altitude-setpoint-ft" value="0.55" />
    </event>
    <event name="Trim F450 ground state">
      <condition>simulation/frame gt 1</condition>
      <set name="simulation/do_simple_trim" value="2" />
    </event>
    <event name="Start motors and climb to local point 0 0 10">
      <condition logic="AND">
        simulation/mission-state eq 0
        simulation/sim-time-sec ge 2.0
      </condition>
      <set name="simulation/mission-state" value="1" />
      <set name="ap/mode" value="3" />
      <set name="ap/north-setpoint-m" value="0.0" />
      <set name="ap/east-setpoint-m" value="0.0" />
      <set name="ap/altitude-setpoint-ft" value="32.80839895" />
      <set name="simulation/next-event-time" value="2.0" type="FG_DELTA" />
    </event>
    <event name="Move to local point 10 0 10">
      <condition logic="AND">
        simulation/mission-state eq 1
        simulation/sim-time-sec ge 25.0
        ap/north-position-error-m ge -2.0
        ap/north-position-error-m le 2.0
        ap/east-position-error-m ge -2.0
        ap/east-position-error-m le 2.0
        ap/altitude-error-ft ge -3.0
        ap/altitude-error-ft le 3.0
        velocities/v-north-fps ge -3.0
        velocities/v-north-fps le 3.0
        velocities/v-east-fps ge -3.0
        velocities/v-east-fps le 3.0
        velocities/h-dot-fps ge -2.0
        velocities/h-dot-fps le 2.0
      </condition>
      <set name="simulation/mission-state" value="2" />
      <set name="ap/north-setpoint-m" value="10.0" />
      <set name="ap/east-setpoint-m" value="0.0" />
      <set name="ap/altitude-setpoint-ft" value="32.80839895" />
      <set name="simulation/next-event-time" value="2.0" type="FG_DELTA" />
    </event>
    <event name="Hover 5 seconds at local point 10 0 10">
      <condition logic="AND">
        simulation/mission-state eq 2
        simulation/sim-time-sec ge 40.0
        ap/north-position-error-m ge -2.0
        ap/north-position-error-m le 2.0
        ap/east-position-error-m ge -2.0
        ap/east-position-error-m le 2.0
        ap/altitude-error-ft ge -3.0
        ap/altitude-error-ft le 3.0
        velocities/v-north-fps ge -3.0
        velocities/v-north-fps le 3.0
        velocities/v-east-fps ge -3.0
        velocities/v-east-fps le 3.0
        velocities/h-dot-fps ge -2.0
        velocities/h-dot-fps le 2.0
      </condition>
      <set name="simulation/mission-state" value="3" />
      <set name="simulation/next-event-time" value="5.0" type="FG_DELTA" />
    </event>
    <event name="Return to local point 0 0 10 from forward point">
      <condition logic="AND">
        simulation/mission-state eq 3
        simulation/sim-time-sec ge 45.0
      </condition>
      <set name="simulation/mission-state" value="4" />
      <set name="ap/north-setpoint-m" value="0.0" />
      <set name="ap/east-setpoint-m" value="0.0" />
      <set name="simulation/next-event-time" value="2.0" type="FG_DELTA" />
    </event>
    <event name="Hover 5 seconds at local point 0 0 10 after forward return">
      <condition logic="AND">
        simulation/mission-state eq 4
        simulation/sim-time-sec ge 60.0
        ap/north-position-error-m ge -2.0
        ap/north-position-error-m le 2.0
        ap/east-position-error-m ge -2.0
        ap/east-position-error-m le 2.0
        ap/altitude-error-ft ge -3.0
        ap/altitude-error-ft le 3.0
        velocities/v-north-fps ge -3.0
        velocities/v-north-fps le 3.0
        velocities/v-east-fps ge -3.0
        velocities/v-east-fps le 3.0
        velocities/h-dot-fps ge -2.0
        velocities/h-dot-fps le 2.0
      </condition>
      <set name="simulation/mission-state" value="5" />
      <set name="simulation/next-event-time" value="5.0" type="FG_DELTA" />
    </event>
    <event name="Move to local point -10 0 10">
      <condition logic="AND">
        simulation/mission-state eq 5
        simulation/sim-time-sec ge 65.0
      </condition>
      <set name="simulation/mission-state" value="6" />
      <set name="ap/north-setpoint-m" value="-10.0" />
      <set name="ap/east-setpoint-m" value="0.0" />
      <set name="simulation/next-event-time" value="2.0" type="FG_DELTA" />
    </event>
    <event name="Hover 5 seconds at local point -10 0 10">
      <condition logic="AND">
        simulation/mission-state eq 6
        simulation/sim-time-sec ge 80.0
        ap/north-position-error-m ge -2.0
        ap/north-position-error-m le 2.0
        ap/east-position-error-m ge -2.0
        ap/east-position-error-m le 2.0
        ap/altitude-error-ft ge -3.0
        ap/altitude-error-ft le 3.0
        velocities/v-north-fps ge -3.0
        velocities/v-north-fps le 3.0
        velocities/v-east-fps ge -3.0
        velocities/v-east-fps le 3.0
        velocities/h-dot-fps ge -2.0
        velocities/h-dot-fps le 2.0
      </condition>
      <set name="simulation/mission-state" value="7" />
      <set name="simulation/next-event-time" value="5.0" type="FG_DELTA" />
    </event>
    <event name="Return to local point 0 0 10 from backward point">
      <condition logic="AND">
        simulation/mission-state eq 7
        simulation/sim-time-sec ge 85.0
      </condition>
      <set name="simulation/mission-state" value="8" />
      <set name="ap/north-setpoint-m" value="0.0" />
      <set name="ap/east-setpoint-m" value="0.0" />
      <set name="simulation/next-event-time" value="2.0" type="FG_DELTA" />
    </event>
    <event name="Hover 5 seconds at local point 0 0 10 after backward return">
      <condition logic="AND">
        simulation/mission-state eq 8
        simulation/sim-time-sec ge 100.0
        ap/north-position-error-m ge -2.0
        ap/north-position-error-m le 2.0
        ap/east-position-error-m ge -2.0
        ap/east-position-error-m le 2.0
        ap/altitude-error-ft ge -3.0
        ap/altitude-error-ft le 3.0
        velocities/v-north-fps ge -3.0
        velocities/v-north-fps le 3.0
        velocities/v-east-fps ge -3.0
        velocities/v-east-fps le 3.0
        velocities/h-dot-fps ge -2.0
        velocities/h-dot-fps le 2.0
      </condition>
      <set name="simulation/mission-state" value="9" />
      <set name="simulation/next-event-time" value="5.0" type="FG_DELTA" />
    </event>
    <event name="Move to local point 0 10 10">
      <condition logic="AND">
        simulation/mission-state eq 9
        simulation/sim-time-sec ge 105.0
      </condition>
      <set name="simulation/mission-state" value="10" />
      <set name="ap/north-setpoint-m" value="0.0" />
      <set name="ap/east-setpoint-m" value="10.0" />
      <set name="simulation/next-event-time" value="2.0" type="FG_DELTA" />
    </event>
    <event name="Hover 5 seconds at local point 0 10 10">
      <condition logic="AND">
        simulation/mission-state eq 10
        simulation/sim-time-sec ge 120.0
        ap/north-position-error-m ge -2.0
        ap/north-position-error-m le 2.0
        ap/east-position-error-m ge -2.0
        ap/east-position-error-m le 2.0
        ap/altitude-error-ft ge -3.0
        ap/altitude-error-ft le 3.0
        velocities/v-north-fps ge -3.0
        velocities/v-north-fps le 3.0
        velocities/v-east-fps ge -3.0
        velocities/v-east-fps le 3.0
        velocities/h-dot-fps ge -2.0
        velocities/h-dot-fps le 2.0
      </condition>
      <set name="simulation/mission-state" value="11" />
      <set name="simulation/next-event-time" value="5.0" type="FG_DELTA" />
    </event>
    <event name="Return to local point 0 0 10 from right point">
      <condition logic="AND">
        simulation/mission-state eq 11
        simulation/sim-time-sec ge 125.0
      </condition>
      <set name="simulation/mission-state" value="12" />
      <set name="ap/north-setpoint-m" value="0.0" />
      <set name="ap/east-setpoint-m" value="0.0" />
      <set name="simulation/next-event-time" value="2.0" type="FG_DELTA" />
    </event>
    <event name="Hover 5 seconds at local point 0 0 10 after right return">
      <condition logic="AND">
        simulation/mission-state eq 12
        simulation/sim-time-sec ge 140.0
        ap/north-position-error-m ge -2.0
        ap/north-position-error-m le 2.0
        ap/east-position-error-m ge -2.0
        ap/east-position-error-m le 2.0
        ap/altitude-error-ft ge -3.0
        ap/altitude-error-ft le 3.0
        velocities/v-north-fps ge -3.0
        velocities/v-north-fps le 3.0
        velocities/v-east-fps ge -3.0
        velocities/v-east-fps le 3.0
        velocities/h-dot-fps ge -2.0
        velocities/h-dot-fps le 2.0
      </condition>
      <set name="simulation/mission-state" value="13" />
      <set name="simulation/next-event-time" value="5.0" type="FG_DELTA" />
    </event>
    <event name="Move to local point 0 -10 10">
      <condition logic="AND">
        simulation/mission-state eq 13
        simulation/sim-time-sec ge 145.0
      </condition>
      <set name="simulation/mission-state" value="14" />
      <set name="ap/north-setpoint-m" value="0.0" />
      <set name="ap/east-setpoint-m" value="-10.0" />
      <set name="simulation/next-event-time" value="2.0" type="FG_DELTA" />
    </event>
    <event name="Hover 5 seconds at local point 0 -10 10">
      <condition logic="AND">
        simulation/mission-state eq 14
        simulation/sim-time-sec ge 160.0
        ap/north-position-error-m ge -2.0
        ap/north-position-error-m le 2.0
        ap/east-position-error-m ge -2.0
        ap/east-position-error-m le 2.0
        ap/altitude-error-ft ge -3.0
        ap/altitude-error-ft le 3.0
        velocities/v-north-fps ge -3.0
        velocities/v-north-fps le 3.0
        velocities/v-east-fps ge -3.0
        velocities/v-east-fps le 3.0
        velocities/h-dot-fps ge -2.0
        velocities/h-dot-fps le 2.0
      </condition>
      <set name="simulation/mission-state" value="15" />
      <set name="simulation/next-event-time" value="5.0" type="FG_DELTA" />
    </event>
    <event name="Return to local point 0 0 10 from left point">
      <condition logic="AND">
        simulation/mission-state eq 15
        simulation/sim-time-sec ge 165.0
      </condition>
      <set name="simulation/mission-state" value="16" />
      <set name="ap/north-setpoint-m" value="0.0" />
      <set name="ap/east-setpoint-m" value="0.0" />
      <set name="simulation/next-event-time" value="2.0" type="FG_DELTA" />
    </event>
    <event name="Hover 5 seconds at local point 0 0 10 before landing">
      <condition logic="AND">
        simulation/mission-state eq 16
        simulation/sim-time-sec ge 180.0
        ap/north-position-error-m ge -2.0
        ap/north-position-error-m le 2.0
        ap/east-position-error-m ge -2.0
        ap/east-position-error-m le 2.0
        ap/altitude-error-ft ge -3.0
        ap/altitude-error-ft le 3.0
        velocities/v-north-fps ge -3.0
        velocities/v-north-fps le 3.0
        velocities/v-east-fps ge -3.0
        velocities/v-east-fps le 3.0
        velocities/h-dot-fps ge -2.0
        velocities/h-dot-fps le 2.0
      </condition>
      <set name="simulation/mission-state" value="17" />
      <set name="simulation/next-event-time" value="5.0" type="FG_DELTA" />
    </event>
    <event name="Vertical landing at local origin">
      <condition logic="AND">
        simulation/mission-state eq 17
        simulation/sim-time-sec ge 185.0
      </condition>
      <set name="simulation/mission-state" value="18" />
      <set name="ap/north-setpoint-m" value="0.0" />
      <set name="ap/east-setpoint-m" value="0.0" />
      <set name="ap/altitude-setpoint-ft" value="0.55" />
      <set name="simulation/next-event-time" value="2.0" type="FG_DELTA" />
    </event>
    <event name="Disarm after vertical landing">
      <condition logic="AND">
        simulation/mission-state eq 18
        simulation/sim-time-sec ge 205.0
        position/h-agl-ft le 1.0
        velocities/h-dot-fps ge -1.5
        velocities/h-dot-fps le 1.5
      </condition>
      <set name="simulation/mission-state" value="19" />
      <set name="ap/mode" value="0" />
      <set name="fcs/throttle-cmd-norm" value="0.0" />
      <set name="simulation/next-event-time" value="0.2" type="FG_DELTA" />
    </event>
    <event name="Terminate mission after disarm">
      <condition logic="AND">
        simulation/mission-state eq 19
        simulation/sim-time-sec ge 210.0
      </condition>
      <set name="simulation/mission-state" value="20" />
      <set name="simulation/terminate" value="1" />
    </event>
    <event name="Repeating notify" persistent="true">
      <condition>simulation/sim-time-sec ge simulation/notify-time-trigger</condition>
      <set name="simulation/notify-time-trigger" value="1.0" type="FG_DELTA" />
      <notify>
        <property>simulation/mission-state</property>
        <property>ap/mode</property>
        <property>ap/north-setpoint-m</property>
        <property>ap/east-setpoint-m</property>
        <property>ap/altitude-setpoint-ft</property>
        <property>position/h-agl-ft</property>
        <property>position/distance-from-start-lat-mt</property>
        <property>position/distance-from-start-lon-mt</property>
        <property>attitude/phi-rad</property>
        <property>attitude/theta-rad</property>
        <property>ap/collective-cmd-norm</property>
      </notify>
    </event>
  </run>
  <output name="F450_10m_box_hover_land.csv" type="CSV" rate="50">
