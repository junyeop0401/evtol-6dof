# jsbsim_workflow source/docs are tracked so Windows clones can use the workflow.
# Keep generated runtime outputs and large data mirrors out of Git.
jsbsim_workflow/logs/**
!jsbsim_workflow/logs/csv/
!jsbsim_workflow/logs/csv/**/
!jsbsim_workflow/logs/csv/**/*.csv
jsbsim_workflow/jsbsim_workflow_data/
jsbsim_workflow/tmp/
jsbsim_workflow/temp/

# Python
__pycache__/
*.pyc

# automation/ 자체 gitignore가 usage_log.jsonl, run_logs/를 이미 처리하지만
# 최상위에서도 한 번 더 명시
automation/usage_log.jsonl
automation/run_logs/

# Windows/WSL 파일 다운로드 메타데이터 (실제 콘텐츠 아님, 손상된 콜론 인코딩 변형 포함)
*:Zone.Identifier
*Zone.Identifier

# 원저작물 아닌 개별 참고 PDF (직접 작성한 산출물이 아니라 저작권/용량 이슈로 제외,
# 필요시 git add -f로 개별 추가 가능)
JSBSim 매뉴얼.pdf
