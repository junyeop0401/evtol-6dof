<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://jsbsim.sourceforge.net/JSBSim.xsl"?>
<fdm_config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            name="standard_vtol_demo"
            version="2.0"
            release="ALPHA"
            xsi:noNamespaceSchemaLocation="http://jsbsim.sourceforge.net/JSBSim.xsd">
  <fileheader>
    <author>IAMAI / Codex demo scaffold</author>
    <filecreationdate>2026-05-06</filecreationdate>
    <version>0.1</version>
    <description>Demo 4-lift-motor plus pusher standard VTOL model for Project AirSim JSBSim integration.</description>
    <note>
      This is a deliberately simplified integration model. It is intended to prove
      Project AirSim, JSBSim, Unreal visualization, and PX4 Standard VTOL actuator
      wiring before replacing the aero/propulsion/mass data with validated DT
      Simulator databases.
    </note>
  </fileheader>

  <metrics>
    <!-- [AD3000 / 2026-07-30] CAD-measured planform.
         Wing skin STEP bbox per span station: root chord 0.355 m -> tip 0.275 m,
         half-span 1.546 m (spec sheet), tip cap rounds to 0.183 m.
         Integrated  S = 0.953 m2,  MAC = S/b = 0.308 m,  AR = b^2/S = 10.03.
         WAS 0.75 m2 / 2.10 m span (demo aircraft) with AD3000's 23.6 kg mass
         -> wing loading 309 N/m2 and stall ~24 m/s, while PX4 was told to
         transition at 10 m/s. That mismatch is the root cause of the
         "no lift during transition" quad-chute (ulg 04_19_58). -->
    <wingarea unit="M2">0.953</wingarea>
    <wingspan unit="M">3.092</wingspan>
    <chord unit="M">0.308</chord>
    <htailarea unit="M2">0.100</htailarea>
    <htailarm unit="M">1.450</htailarm>
    <vtailarea unit="M2">0.060</vtailarea>
    <vtailarm unit="M">1.450</vtailarm>
    <location name="AERORP" unit="M">
      <x>0.0</x>
      <y>0.0</y>
      <z>0.0</z>
    </location>
    <location name="EYEPOINT" unit="M">
      <x>0.15</x>
      <y>0.0</y>
      <z>-0.05</z>
    </location>
    <location name="VRP" unit="M">
      <x>0.0</x>
      <y>0.0</y>
      <z>0.0</z>
    </location>
  </metrics>

  <mass_balance>
    <!-- AD3000 placeholder mass/inertia (matches robot config + rotor thrust; MTOW 23.6 kg).
         WAS 5.0 kg / 0.15-0.25 -> caused TWR ~13 and uncommanded launch. -->
    <ixx unit="KG*M2">10.7000</ixx>
    <iyy unit="KG*M2">8.0000</iyy>
    <izz unit="KG*M2">18.5000</izz>
    <emptywt unit="KG">23.6</emptywt>
    <location name="CG" unit="M">
      <x>0.0</x>
      <y>0.0</y>
      <z>0.0</z>
    </location>
  </mass_balance>

